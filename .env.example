S3_ROOT_USER=financeadmin
S3_ROOT_PASSWORD=change_this_local_password
KAFKA_HOST_PORT=9092
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
TRADES_PER_SECOND=220
BATCH_SIZE=10000
BATCH_SECONDS=30
SHOCK_AFTER_SECONDS=360
SHOCK_EVERY_SECONDS=300

ICEBERG_JDBC_USER=iceberg
ICEBERG_JDBC_PASSWORD=change_this_catalog_password

# Spark Structured Streaming -> Iceberg Silver
ICEBERG_VERSION=1.12.0
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=6
SPARK_LOG_LEVEL=WARN
WATERMARK_DELAY=2 minutes
SILVER_TRIGGER_INTERVAL=60 seconds
SILVER_CHECKPOINT_LOCATION=s3a://silver/checkpoints/ohlc_1m
KAFKA_STARTING_OFFSETS=earliest
KAFKA_MAX_OFFSETS_PER_TRIGGER=50000
